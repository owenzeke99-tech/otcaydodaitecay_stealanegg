local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- Key and Script Configuration
local CorrectKey = "ChilliHubV8KeyHskwkwhejLaljwkwwjlKanwkwkwkeop"
local GetKeyLink = "https://link4m.net/f2LbIb"
local ScriptURL = "https://raw.githubusercontent.com/napun87/stealanegg/refs/heads/main/chilli.otcaydodaiNoKey3.7.lua"

local KEY_TTL_SECONDS = 24 * 60 * 60
local SAVE_FILE_NAME = "ChilliHubV8_SessionCache.json"

-- Silent 24h Key Cache Helpers (No 24h text displayed on UI)
local function ReadSavedKeyRecord()
	if type(isfile) == "function" and type(readfile) == "function" then
		local ok, exists = pcall(isfile, SAVE_FILE_NAME)
		if ok and exists then
			local rOk, content = pcall(readfile, SAVE_FILE_NAME)
			if rOk and type(content) == "string" and #content > 0 then
				local dOk, decoded = pcall(function()
					return HttpService:JSONDecode(content)
				end)
				if dOk and type(decoded) == "table" then
					return decoded
				end
			end
		end
	end

	local sharedCache = rawget(shared, "_ChilliHubV8_KeyCache")
	if type(sharedCache) == "table" then
		return sharedCache
	end
	return nil
end

local function SaveKeyRecordFor24h(keyValue)
	local record = {
		key = keyValue,
		expires = os.time() + KEY_TTL_SECONDS
	}

	if type(writefile) == "function" then
		local eOk, encoded = pcall(function()
			return HttpService:JSONEncode(record)
		end)
		if eOk and type(encoded) == "string" then
			pcall(writefile, SAVE_FILE_NAME, encoded)
		end
	end

	rawset(shared, "_ChilliHubV8_KeyCache", record)
end

local function HasValidSavedKey()
	local record = ReadSavedKeyRecord()
	if type(record) ~= "table" then
		return false
	end
	if record.key ~= CorrectKey then
		return false
	end
	if type(record.expires) ~= "number" or os.time() >= record.expires then
		return false
	end
	return true
end

local function LaunchMainScript()
	loadstring(game:HttpGet(ScriptURL))()
end

-- If a valid key is still within its 24h window, launch directly
if HasValidSavedKey() then
	LaunchMainScript()
	return
end

