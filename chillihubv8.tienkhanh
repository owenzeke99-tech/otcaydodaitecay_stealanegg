local noticeToken = 0
local activeDrainTween = nil

local function ShowInMenuNotice(titleText, subText, kind)
	noticeToken += 1
	local currentToken = noticeToken

	if activeDrainTween then
		activeDrainTween:Cancel()
		activeDrainTween = nil
	end

	local bgColor, strokeColor, badgeColor, iconText, titleColor, targetBgTransp
	if kind == "error" then
		bgColor = Color3.fromRGB(135, 14, 26)
		strokeColor = Color3.fromRGB(255, 85, 102)
		badgeColor = Color3.fromRGB(235, 32, 52)
		iconText = "!"
		titleColor = Color3.fromRGB(255, 240, 242)
		targetBgTransp = 0.34
	elseif kind == "success" then
		bgColor = Color3.fromRGB(18, 96, 52)
		strokeColor = Color3.fromRGB(95, 240, 148)
		badgeColor = Color3.fromRGB(35, 185, 95)
		iconText = "✓"
		titleColor = Color3.fromRGB(235, 255, 242)
		targetBgTransp = 0.34
	else
		bgColor = Color3.fromRGB(22, 20, 24)
		strokeColor = Color3.fromRGB(255, 130, 145)
		badgeColor = Color3.fromRGB(210, 45, 65)
		iconText = "i"
		titleColor = Color3.fromRGB(255, 235, 238)
		targetBgTransp = 0.38
	end

	NoticeCard.BackgroundColor3 = bgColor
	NoticeStroke.Color = strokeColor
	NoticeBadge.BackgroundColor3 = badgeColor
	NoticeIcon.Text = iconText
	NoticeTitle.Text = titleText
	NoticeTitle.TextColor3 = titleColor
	NoticeSub.Text = subText
	NoticeTimer.BackgroundColor3 = strokeColor

	NoticeCard.Position = UDim2.new(0.5, 0, 0, 136)
	NoticeCard.BackgroundTransparency = 1
	NoticeStroke.Transparency = 1
	NoticeBadge.BackgroundTransparency = 1
	NoticeIcon.TextTransparency = 1
	NoticeTitle.TextTransparency = 1
	NoticeSub.TextTransparency = 1
	TimerTrack.BackgroundTransparency = 1
	NoticeTimer.Size = UDim2.new(1, 0, 1, 0)
	NoticeTimer.BackgroundTransparency = 1

	TweenService:Create(NoticeCard, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 130),
		BackgroundTransparency = targetBgTransp
	}):Play()
	TweenService:Create(NoticeStroke, TweenInfo.new(0.22), {Transparency = 0.12}):Play()
	TweenService:Create(NoticeBadge, TweenInfo.new(0.22), {BackgroundTransparency = 0.15}):Play()
	TweenService:Create(NoticeIcon, TweenInfo.new(0.22), {TextTransparency = 0}):Play()
	TweenService:Create(NoticeTitle, TweenInfo.new(0.22), {TextTransparency = 0}):Play()
	TweenService:Create(NoticeSub, TweenInfo.new(0.22), {TextTransparency = 0}):Play()
	TweenService:Create(TimerTrack, TweenInfo.new(0.2), {BackgroundTransparency = 0.85}):Play()
	TweenService:Create(NoticeTimer, TweenInfo.new(0.2), {BackgroundTransparency = 0.05}):Play()

	local duration = 3.0
	activeDrainTween = TweenService:Create(NoticeTimer, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0)
	})
	activeDrainTween:Play()

	task.delay(duration, function()
		if noticeToken ~= currentToken then return end
		TweenService:Create(NoticeCard, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
		TweenService:Create(NoticeStroke, TweenInfo.new(0.22), {Transparency = 1}):Play()
		TweenService:Create(NoticeBadge, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
		TweenService:Create(NoticeIcon, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
		TweenService:Create(NoticeTitle, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
		TweenService:Create(NoticeSub, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
		TweenService:Create(TimerTrack, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
		TweenService:Create(NoticeTimer, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
	end)
end

-- Modern Button Factory
local function CreateActionButton(text, pos, size, isPrimary)
	local Btn = Instance.new("TextButton")
	Btn.Parent = MainFrame
	Btn.Position = pos
	Btn.Size = size
	Btn.Font = Enum.Font.MontserratBold
	Btn.Text = text
	Btn.TextSize = 13
	Btn.AutoButtonColor = false
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 11)

	local BtnStroke = Instance.new("UIStroke")
	BtnStroke.Parent = Btn
	BtnStroke.Thickness = 1.3

	if isPrimary then
		Btn.BackgroundColor3 = Color3.fromRGB(215, 26, 46)
		Btn.BackgroundTransparency = 0.25
		Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		BtnStroke.Color = Color3.fromRGB(255, 110, 125)
		BtnStroke.Transparency = 0.2
	else
		Btn.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
		Btn.BackgroundTransparency = 0.48
		Btn.TextColor3 = Color3.fromRGB(255, 140, 152)
		BtnStroke.Color = Color3.fromRGB(215, 38, 56)
		BtnStroke.Transparency = 0.3
	end

	Btn.MouseEnter:Connect(function()
		TweenService:Create(Btn, TweenInfo.new(0.18), {
			BackgroundTransparency = 0.1,
			BackgroundColor3 = isPrimary and Color3.fromRGB(245, 42, 62) or Color3.fromRGB(32, 18, 22)
		}):Play()
	end)
	Btn.MouseLeave:Connect(function()
		TweenService:Create(Btn, TweenInfo.new(0.18), {
			BackgroundTransparency = isPrimary and 0.25 or 0.48,
			BackgroundColor3 = isPrimary and Color3.fromRGB(215, 26, 46) or Color3.fromRGB(16, 16, 20)
		}):Play()
	end)

	return Btn
end

local CheckBtn = CreateActionButton("CHECK KEY", UDim2.new(0, 22, 0, 194), UDim2.new(0.5, -28, 0, 46), true)
local GetKeyBtn = CreateActionButton("GET KEY", UDim2.new(0.5, 6, 0, 194), UDim2.new(0.5, -28, 0, 46), false)

-- Smooth Damped Shake on Invalid Key
local isShaking = false
local function SmoothShake()
	if isShaking then return end
	isShaking = true

	local basePos = MainFrame.Position
	local steps = {-11, 11, -8, 8, -5, 5, -2, 2, 0}
	local stepInfo = TweenInfo.new(0.042, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

	TweenService:Create(MainStroke, TweenInfo.new(0.14), {Color = Color3.fromRGB(255, 65, 82), Thickness = 2.4, Transparency = 0}):Play()
	TweenService:Create(InputStroke, TweenInfo.new(0.14), {Color = Color3.fromRGB(255, 65, 82), Thickness = 1.8, Transparency = 0}):Play()

	for _, offset in ipairs(steps) do
		local tween = TweenService:Create(MainFrame, stepInfo, {
			Position = UDim2.new(basePos.X.Scale, basePos.X.Offset + offset, basePos.Y.Scale, basePos.Y.Offset)
		})
		tween:Play()
		tween.Completed:Wait()
	end

	TweenService:Create(MainStroke, TweenInfo.new(0.28), {Color = Color3.fromRGB(235, 38, 58), Thickness = 1.6, Transparency = 0.2}):Play()
	TweenService:Create(InputStroke, TweenInfo.new(0.28), {Color = Color3.fromRGB(210, 35, 52), Thickness = 1.3, Transparency = 0.3}):Play()
	isShaking = false
end

-- Key Verification Logic (Triggered ONLY when clicking CHECK KEY)
local function VerifyKey()
	local enteredKey = string.gsub(KeyBox.Text, "^%s*(.-)%s*$", "%1")

	if enteredKey == CorrectKey then
		SaveKeyRecordFor24h(enteredKey)
		ShowInMenuNotice("Access Granted", "Key verified! Launching Chilli Hub V8...", "success")
		TweenService:Create(MainStroke, TweenInfo.new(0.22), {Color = Color3.fromRGB(95, 240, 148)}):Play()

		task.wait(0.75)
		TweenService:Create(MainFrame, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 330, 0, 210),
			BackgroundTransparency = 1
		}):Play()
		task.wait(0.24)
		ScreenGui:Destroy()

		LaunchMainScript()
	else
		ShowInMenuNotice("Invalid Key", "The key you entered is wrong. Try again.", "error")
		KeyBox.Text = ""
		task.spawn(SmoothShake)
	end
end

GetKeyBtn.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard(GetKeyLink)
		ShowInMenuNotice("Link Copied", "Get-key link has been copied to clipboard.", "info")
	else
		ShowInMenuNotice("Clipboard Error", "Executor does not support clipboard copy.", "error")
	end
end)

CheckBtn.MouseButton1Click:Connect(VerifyKey)

